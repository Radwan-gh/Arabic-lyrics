generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(VIEWER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lyrics    Lyrics[]
  playlists Playlist[]
  favorites Favorite[]
}

model Lyrics {
  id        String   @id @default(cuid())
  title     String
  // مفتاح مطابقة موحّد للعنوان (normalizeArabic) — يُستخدم لكشف التكرار.
  titleNormalized String @default("")
  artist    String?
  album     String?
  content   String   @db.Text
  tags      String[] @default([])
  viewCount Int      @default(0)

  // نسخة مُطبَّعة مسبقًا من (العنوان + الفنان + المقام + كلمات النشيد) للبحث النصّي
  // المتجاهل للتشكيل والموحِّد لصور الأحرف. تُبنى عبر buildSearchText في src/lib/arabic-search.ts.
  searchText String @default("") @db.Text

  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  playlistItems PlaylistItem[]
  favorites     Favorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
  @@index([titleNormalized])
  @@index([artist])
}

model Playlist {
  id          String  @id @default(cuid())
  title       String
  description String?
  isPublic    Boolean @default(false)
  shareToken  String  @unique @default(cuid())

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  items PlaylistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model PlaylistItem {
  id       String @id @default(cuid())
  position Int    @default(0)

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  playlistId String

  lyrics   Lyrics @relation(fields: [lyricsId], references: [id], onDelete: Cascade)
  lyricsId String

  addedAt DateTime @default(now())

  @@unique([playlistId, lyricsId])
  @@index([playlistId])
}

model Favorite {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  lyrics   Lyrics @relation(fields: [lyricsId], references: [id], onDelete: Cascade)
  lyricsId String

  createdAt DateTime @default(now())

  @@unique([userId, lyricsId])
  @@index([userId])
}
