{
  "name": "arabic-lyrics",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.18.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "prisma db push --accept-data-loss --skip-generate && sh -c 'if [ \"$SEED_ON_START\" = \"true\" ]; then npm run db:seed || true; fi' && (npm run db:backfill-search || true) && next start -p ${PORT:-3000}",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:anaasheed": "tsx prisma/seed-anaasheed.ts",
    "db:backfill-search": "tsx prisma/backfill-search-text.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/sanitize-html": "^2.13.0",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^2.4.3",
    "html-to-image": "^1.11.13",
    "jose": "^5.9.6",
    "lucide-react": "^1.31.0",
    "next": "^15.1.0",
    "postcss": "^8.4.49",
    "prisma": "^6.2.0",
    "quill": "^2.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.13.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0"
  }
}
