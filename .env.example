# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/arabic_lyrics?schema=public"

# Long random secret used to sign session JWTs. Generate one with:
#   openssl rand -base64 48
JWT_SECRET="change-this-to-a-long-random-string"

# Used only by `npm run db:seed` to create/update the initial admin account.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"

# Optional: "Sign in with Google". When both are set, the login page shows a
# Google button; new Google accounts are created as Viewers pending admin
# approval (Admin → Users). Create an OAuth client (type "Web application") in
# Google Cloud Console → APIs & Services → Credentials, and add this as an
# authorized redirect URI:  <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public origin of the app (no trailing slash), used to build the Google
# redirect URI, e.g. https://your-app.up.railway.app. Falls back to the
# request host when unset.
APP_URL=""
