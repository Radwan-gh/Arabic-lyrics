# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/arabic_lyrics?schema=public"

# Long random secret used to sign session JWTs. Generate one with:
#   openssl rand -base64 48
JWT_SECRET="change-this-to-a-long-random-string"

# Used only by `npm run db:seed` to create/update the initial admin account.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"
